# Runtime identity. Production must use "production"; test.pay uses "test".
PERKOS_PAY_ENV=test

# Server-only PerkOS API origin. Do not prefix this with NEXT_PUBLIC_.
PERKOS_API_URL=https://api.perkos.xyz

# Canonical public origin for this deployment.
PERKOS_PAY_ORIGIN=https://test.pay.perkos.xyz

# Payment execution is intentionally disabled until the billing-session contract ships.
PERKOS_PAYMENTS_ENABLED=false

# Server-only Stripe credentials. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Durable idempotency journal for verified test events.
PAYMENT_EVENT_STORE=/data/payment-events

# Server-only Coinbase Developer Platform credentials for Onramp session tokens.
# Never prefix these with NEXT_PUBLIC_. Leave empty to keep card-to-USDC hidden.
# The secret is either a PEM (ECDSA keys) or a base64 64-byte Ed25519 key.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
